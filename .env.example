# ─────────────────────────────────────────────────────────────────────────────
# SuaraNafas — environment template
#
# Salin ke `.env.local` (frontend) dan set variabel backend di shell Anda
# (backend tidak membaca file .env). JANGAN pernah commit file ini.
#
#   cp .env.example .env.local
#
# Semua variabel bersifat opsional. Dengan konfigurasi kosong, aplikasi
# berjalan dalam mode aman: backend melaporkan "unavailable" dan halaman
# analisis menolak menghasilkan prediksi alih-alih menampilkan angka palsu.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend: mode demo ──────────────────────────────────────────────────────
# Menghasilkan hasil simulasi TANPA model. Hanya berlaku di luar production
# DAN harus diaktifkan secara eksplisit. production mengabaikannya.
#ALLOW_DEMO_MODE=false

# ── Frontend: backend model ─────────────────────────────────────────────────
# URL FastAPI yang menjalankan /predict. Kosongkan jika backend belum siap;
# aplikasi akan menolak prediksi dengan HTTP 503.
#BACKEND_API_URL=http://127.0.0.1:8000

# ── Frontend: Firebase Auth (opsional, untuk export hasil) ──────────────────
# Nilai ini masuk ke bundle browser (prefix NEXT_PUBLIC_), jadi JANGAN pernah
# menaruh secret di sini. Kunci API Firebase memang memang dimaksudkan publik,
# tapi tetap batasi lewat domain dan Security Rules.
#NEXT_PUBLIC_FIREBASE_API_KEY=
#NEXT_PUBLIC_FIREBASE_APP_ID=
#NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
#NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Frontend: endpoint /api/chat (opsional) ─────────────────────────────────
# Route /api/chat nonaktif bila unset. Tanpa ini, halaman obrolan akan
# menjpjelaskan bahwa fitur tidak dikonfigurasi — bukan diam-diam gagal.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=

# ═════════════════════════════════════════════════════════════════════════════
# Backend (deploy/model-space) — diekspor ke shell, bukan dibaca dari .env
# ═════════════════════════════════════════════════════════════════════════════

# Manifest model terlatih. Tanpa ini backend selalu "unavailable".
#MODEL_MANIFEST_PATH=training-output/manifest.json

# "production" memblokir kandidat riset tanpa syarat.
#DEPLOYMENT_ENV=development

# Izinkan manifest berstatus blocked HANYA di development/staging.
# Gate ini sengaja dibuat ketat: inilah yang mencegah model yang belum
# tervalidasi ikut terbawa ke produksi.
#ALLOW_BLOCKED_CANDIDATE=false

# cpu | cuda
#MODEL_DEVICE=cpu

# Origin yang diizinkan oleh CORS. Kosongkan memakai default localhost.
#ALLOWED_ORIGINS=http://localhost:3000

# ── Unduhan data (hanya untuk script download_*, bukan runtime) ─────────────
# Token Synapse setelah Anda menerima syarat CODA-TB. JANGAN di-commit.
#SYNAPSE_AUTH_TOKEN=
#CODA_DATA_DIR=coda-tb


# ═════════════════════════════════════════════════════════════════════════════
# Pembayaran QRIS (Midtrans) — opsional.
# Tanpa MIDTRANS_SERVER_KEY, checkout tidak aktif dan analisis tetap berjalan
# tanpa biaya.
# ═════════════════════════════════════════════════════════════════════════════

# Server key dari Dashboard Midtrans. JANGAN pernah commit nilai ini.
# Hanya server yang boleh mengetahuinya; browser hanya menerima harga.
#MIDTRANS_SERVER_KEY=

# true (default) memakai sandbox: tidak ada uang sungguhan yang berpindah.
# Setel "false" HANYA setelah akun production dan legalitas siap.
#MIDTRANS_SANDBOX=true

# ── Firebase Admin (server-side) ────────────────────────────────────────────
# Dipakai untuk memverifikasi ID token dan menyimpan order di Firestore.
# Service account JSON: Firebase Console > Project Settings > Service accounts.
#FIREBASE_CLIENT_EMAIL=
#FIREBASE_PRIVATE_KEY=
#FIREBASE_PROJECT_ID=
